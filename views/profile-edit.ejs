<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Profile | Pinterest Clone</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/tailwind.css">
</head>

<body class="min-h-screen bg-[#fafafa] text-[#111]">

    <main class="mx-auto max-w-3xl px-5 py-8 sm:px-8 sm:py-12">

        <!-- Header -->
        <header class="mb-10">

            <a href="/profile"
                class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition duration-200 ease-in-out hover:text-black">

                <span class="text-xl">←</span>
                Back to profile
            </a>

            <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
                Edit profile
            </h1>

            <p class="mt-2 text-sm text-gray-500 sm:text-base">
                Make your profile feel more like you.
            </p>

        </header>

        <section class="rounded-3xl border border-gray-200 bg-white p-5 shadow-sm sm:p-9">

            <form action="/profile-edit" method="POST" enctype="multipart/form-data" class="flex flex-col gap-7">


                <div class="border-b border-gray-100 pb-7">

                    <h2 class="mb-5 text-lg font-semibold">
                        Profile picture
                    </h2>

                    <div class="flex items-center gap-5">

                        <img id="profilePreview" src="<%= user.dp || '/images/default-avatar.jpeg' %>"
                            alt="Profile picture"
                            class="h-24 w-24 rounded-full border border-gray-200 object-cover sm:h-28 sm:w-28">

                        <div class="min-w-0">

                            <h3 class="truncate text-base font-semibold">
                                <%= user.username %>
                            </h3>

                            <p class="mt-1 text-sm text-gray-500">
                                Update your profile picture.
                            </p>

                            <label for="profileImage"
                                class="mt-3 inline-flex cursor-pointer items-center justify-center rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-800 transition duration-200 ease-in-out hover:bg-gray-200">
                                Change photo
                            </label>

                            <input type="file" id="profileImage" name="dp" accept="image/*" class="hidden">

                            <p class="mt-2 text-xs text-gray-400">
                                Choose an image from your device.
                            </p>
                        </div>
                    </div>
                </div>
                <div>
                    <label for="fullname" class="mb-2 block text-sm font-semibold">
                        Full name
                    </label>

                    <input type="text" id="fullname" name="fullname" value="<%= user.fullname || '' %>"
                        placeholder="Enter your full name" autocomplete="name" required
                        class="w-full rounded-xl border border-gray-200 bg-[#fafafa] px-4 py-3.5 text-sm outline-none transition duration-200 ease-in-out focus:border-[#15638f] focus:bg-white focus:ring-2 focus:ring-[#15638f]/10">
                </div>

                <div>
                    <label for="username" class="mb-2 block text-sm font-semibold">
                        Username
                    </label>
                    <input type="text" id="username" name="username" value="<%= user.username || '' %>"
                        placeholder="Choose a username" autocomplete="username" required
                        class="w-full rounded-xl border border-gray-200 bg-[#fafafa] px-4 py-3.5 text-sm outline-none transition duration-200 ease-in-out focus:border-[#15638f] focus:bg-white focus:ring-2 focus:ring-[#15638f]/10">

                </div>

                <div>
                    <label for="email" class="mb-2 block text-sm font-semibold">
                        Email address
                    </label>
                    <input type="email" id="email" name="email" value="<%= user.email || '' %>"
                        placeholder="Enter your email address" autocomplete="email" required
                        class="w-full rounded-xl border border-gray-200 bg-[#fafafa] px-4 py-3.5 text-sm outline-none transition duration-200 ease-in-out focus:border-[#15638f] focus:bg-white focus:ring-2 focus:ring-[#15638f]/10">
                </div>
                <div class="flex flex-col-reverse gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:justify-end">
                    <a href="/profile"
                        class="flex items-center justify-center rounded-full bg-gray-100 px-7 py-3 text-sm font-semibold text-gray-800 transition duration-200 ease-in-out hover:bg-gray-200">
                        Cancel
                    </a>
                    <button type="submit"
                        class="flex items-center justify-center rounded-full bg-[#15638f] px-7 py-3 text-sm font-semibold text-white transition duration-200 ease-in-out hover:-translate-y-0.5 hover:bg-[#104d70] hover:shadow-md active:translate-y-0">
                        Save changes
                    </button>
                </div>
            </form>
        </section>
        <footer class="mt-6 text-center">
            <p class="text-xs text-gray-400">
                Keep your profile information up to date.
            </p>
        </footer>
    </main>
    <script>
        const profileImage = document.getElementById("profileImage");
        const profilePreview = document.getElementById("profilePreview");

        profileImage.addEventListener("change", function () {
            const file = this.files[0];

            if (file && file.type.startsWith("image/")) {
                profilePreview.src = URL.createObjectURL(file);
            }
        });
    </script>


</body>

</html>