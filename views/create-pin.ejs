<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Pin | Pinterest Clone</title>

    <link rel="stylesheet" href="/stylesheets/tailwind.css">
</head>

<body class="min-h-screen bg-[#fafafa] text-[#111]">
    <main class="mx-auto max-w-4xl px-5 py-8 sm:px-8 sm:py-12">

        <!-- Header -->
        <header class="mb-10">
            <a href="/profile"
                class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition duration-200 ease-in-out hover:text-black">

                <span class="text-xl">←</span>
                Back to profile
            </a>
            <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">Create Pin</h1>
            <p class="mt-2 text-sm text-gray-500 sm:text-base">
                Share something inspiring with the world.
            </p>

        </header>

        <!-- Create Pin Form -->
        <section class="rounded-3xl border border-gray-200 bg-white p-5 shadow-sm sm:p-9">

            <form action="/uploads" method="POST" enctype="multipart/form-data" class="flex flex-col gap-7">

                <!-- Image Upload -->
                <div class="border-b border-gray-100 pb-7">

                    <h2 class="mb-5 text-lg font-semibold">Pin image</h2>

                    <label for="pinImage"
                        class="flex min-h-[300px] cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-gray-200 bg-[#fafafa] p-5 text-center transition duration-200 ease-in-out hover:border-[#15638f] hover:bg-gray-50 sm:min-h-[380px]">

                        <!-- Selected Image Preview -->
                        <img id="imagePreview" src="" class="hidden max-h-[350px] w-full rounded-xl object-contain">

                        <!-- Default Upload Content -->
                        <div id="uploadPlaceholder" class="flex flex-col items-center">

                            <div
                                class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-sm">

                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[#15638f]" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">

                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M12 16V4m0 0L8 8m4-4 4 4M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3" />
                                </svg>

                            </div>

                            <h3 class="text-base font-semibold">
                                Choose an image
                            </h3>

                            <p class="mt-2 max-w-xs text-sm leading-6 text-gray-500">
                                Upload an image from your device to create your Pin.
                            </p>

                            <span
                                class="mt-5 rounded-full bg-[#15638f] px-5 py-2.5 text-sm font-semibold text-white transition duration-200 ease-in-out hover:bg-[#104d70]">
                                Select image
                            </span>

                            <p class="mt-4 text-xs text-gray-400">
                                PNG, JPG or WEBP
                            </p>

                        </div>

                    </label>

                    <input type="file" id="pinImage" name="file" accept="image/jpeg,image/png,image/webp" class="hidden"
                        required>

                    <p id="imageError" class="mt-2 hidden text-sm text-red-600">
                        Please select a valid image.
                    </p>

                </div>

                <!-- Pin Details -->
                <div>
                    <h2 class="mb-5 text-lg font-semibold">
                        Pin details
                    </h2>

                    <label for="filecaption" class="mb-2 block text-sm font-semibold">
                        Description
                    </label>

                    <textarea id="filecaption" name="filecaption" rows="3" maxlength="250"
                        placeholder="What is your Pin about?"
                        class="w-full resize-y rounded-xl border border-gray-200 bg-[#fafafa] px-4 py-3.5 text-sm outline-none transition duration-200 ease-in-out placeholder:text-gray-400 focus:border-[#15638f] focus:bg-white focus:ring-2 focus:ring-[#15638f]/10"></textarea>

                    <p class="mt-2 text-xs text-gray-400">
                        Add a description to tell people more about your image.
                    </p>

                </div>

                <!-- Actions -->
                <div class="flex flex-col-reverse gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:justify-end">

                    <a href="/profile"
                        class="flex items-center justify-center rounded-full bg-gray-100 px-7 py-3 text-sm font-semibold text-gray-800 transition duration-200 ease-in-out hover:bg-gray-200">
                        Cancel
                    </a>

                    <button type="submit"
                        class="flex items-center justify-center rounded-full bg-[#15638f] px-7 py-3 text-sm font-semibold text-white transition duration-200 ease-in-out hover:-translate-y-0.5 hover:bg-[#104d70] hover:shadow-md active:translate-y-0">
                        Publish Pin
                    </button>
                </div>
            </form>
        </section>

        <!-- Footer -->
        <footer class="mt-6 text-center">
            <p class="text-xs text-gray-400">
                Every Pin tells a story. Make yours worth sharing.
            </p>
        </footer>

    </main>

    <!-- Image Preview -->
    <script>
        const pinImage = document.getElementById("pinImage");
        const imagePreview = document.getElementById("imagePreview");
        const uploadPlaceholder = document.getElementById("uploadPlaceholder");
        const imageError = document.getElementById("imageError");

        let previewUrl = null;

        pinImage.addEventListener("change", function () {
            const file = this.files[0];

            imageError.classList.add("hidden");

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            if (!file) {
                imagePreview.classList.add("hidden");
                imagePreview.removeAttribute("src");
                uploadPlaceholder.classList.remove("hidden");
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                this.value = "";

                imageError.textContent =
                    "Please select a JPG, PNG or WEBP image.";

                imageError.classList.remove("hidden");
                imagePreview.classList.add("hidden");
                imagePreview.removeAttribute("src");
                uploadPlaceholder.classList.remove("hidden");

                return;
            }

            previewUrl = URL.createObjectURL(file);

            imagePreview.src = previewUrl;
            imagePreview.classList.remove("hidden");
            uploadPlaceholder.classList.add("hidden");
        });
    </script>

</body>

</html>