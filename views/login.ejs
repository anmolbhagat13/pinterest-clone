<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pinterest Clone</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
  <div class="container">
    <div class="content">
      <!--pinterest logo-->
      <img src="/images/PinterestLogo.png" alt="pin logo"
        class="img1" />
      <p class="header">Login your account</p>

      <% if(error.length > 0){ %>
        <p class="error"> <%= error %></p>
      <% } %>

      <form action="/login" method="post">
        <input type="text" name="username" placeholder="Username" class="detail" required /><br />
        <input type="password" name="password" placeholder="Password" class="detail" required />
        <input type="submit" class="btn int" value="Login">
      </form>
      
      <footer>
        <p>
          By continuing, you agree to Pinterest's
          <b>Terms of Service, Privacy policy.</b>
        </p>
        <hr />
        <a href="/">Not on Pinterest yet? Sign up</a>
      </footer>
    </div>
  </div>
</body>

</html>