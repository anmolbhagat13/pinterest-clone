<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pinterest Clone</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
  <div class="container">
    <div class="content">
      <!--pinterest logo-->
      <img src="/images/PinterestLogo.png" class="img1" />
      <p class="header">Create your account</p>
      <form action="/register" method="post">
        <input type="email" name="email" placeholder="Email" class="detail" required /><br />

        <input type="text" name="username" placeholder="Username" class="detail" required /><br />

        <input type="text" name="fullname" placeholder="Full Name" class="detail" required /><br />

        <input type="password" name="password" placeholder="Password" class="detail" required />

        <input type="submit" class="btn int" value="Register">
      </form>
      <footer>
        <p>
          By continuing, you agree to Pinterest's
          <b>Terms of Service, Privacy policy.</b>
        </p>
        <hr />
        <a href="/login">Already on Pinterest? Login</a>
      </footer>
    </div>
  </div>
</body>

</html>