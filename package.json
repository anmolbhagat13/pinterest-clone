{
  "name": "pinora",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build:css && node ./bin/www",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/stylesheets/tailwind.css",
    "dev": "concurrently \"nodemon ./bin/www\" \"npm run build:css -- --watch\""
  },
  "dependencies": {
    "connect-flash": "^0.1.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "ejs": "~2.6.1",
    "express": "~4.16.1",
    "express-session": "^1.19.0",
    "http-errors": "~1.6.3",
    "mongoose": "^9.11.3",
    "morgan": "~1.9.1",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.2.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tailwindcss": "^3.4.19"
  }
}
